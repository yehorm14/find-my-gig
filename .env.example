# Copy to .env and fill in. .env is gitignored.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# true for local development, false (default) in production.
DEBUG=true

# Comma-separated. In DEBUG mode defaults to 127.0.0.1,localhost.
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated origins including scheme, e.g. https://example.onrender.com
CSRF_TRUSTED_ORIGINS=

# Optional. Without them geocoding is skipped and maps show a placeholder.
GOOGLE_MAPS_FRONTEND_KEY=
GOOGLE_MAPS_BACKEND_KEY=

# Optional. Without them password-reset emails are printed to the console.
EMAIL_USER=
EMAIL_PASS=
